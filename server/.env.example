# 一般不用手动创建：运行 bash install.sh 会自动生成 .env
# 部署模式：standalone / nginx / host-nginx
RELAY_MODE=nginx
# 服务器公网 IP（客户端只接受 IP，不要填域名）
RELAY_PUBLIC_HOST=1.2.3.4
# 对外端口：nginx 模式默认 443，其余默认 8443
RELAY_PORT=443
# host-nginx 模式下中转服务监听的本机端口（只绑 127.0.0.1）
RELAY_LOCAL_PORT=18080
# 留空 = 在服务器上本地构建镜像；填 ghcr.io/<用户名>/stock-relay:latest = 拉取 Actions 构建好的镜像
RELAY_IMAGE=

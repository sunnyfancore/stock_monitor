# 模式三（docker-compose.host-nginx.yml）：加到服务器上已有的 nginx 里
# install.sh 会自动把 __DATA_DIR__ / __LOCAL_PORT__ / __PORT__ 替换成实际值，生成 nginx/host-nginx.conf
#
# 放置方法（任选其一，然后 nginx -t && systemctl reload nginx）：
#   Debian/Ubuntu: cp nginx/host-nginx.conf /etc/nginx/conf.d/stock-relay.conf
#   宝塔面板:       粘贴到 网站 → 添加站点后的“配置文件”，或放进 /www/server/panel/vhost/nginx/
#
# 重要：客户端按 IP 连接、不带 SNI，nginx 会把它交给该端口上的 default_server。
#   - 推荐用独立端口（默认 8443），与现有网站互不影响；
#   - 若要用 443：必须让这个 server 成为 443 的 default_server（现有站点里不能再有 default_server），
#     否则客户端会拿到你网站的证书，指纹对不上而拒绝连接（这是安全设计，不是故障）。

upstream stock_relay_local {
    server 127.0.0.1:__LOCAL_PORT__;
    keepalive 8;
    keepalive_timeout 10s;     # 必须短于中转服务的 20s 空闲超时（需 nginx 1.15.3+）
}

server {
    listen __PORT__ ssl default_server;
    # 需要 IPv6 时再加：listen [::]:__PORT__ ssl default_server;
    server_name _;

    # 必须使用中转服务生成的证书（与客户端连接串里的指纹一致），不能换成网站证书
    ssl_certificate     __DATA_DIR__/cert.pem;
    ssl_certificate_key __DATA_DIR__/key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    server_tokens off;
    access_log off;
    client_max_body_size 16k;

    location = /api {
        if ($request_method != POST)   { return 404; }
        if ($http_authorization = "")  { return 404; }
        proxy_pass http://stock_relay_local;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        proxy_buffering off;
    }

    location / {
        return 404;
    }
}
